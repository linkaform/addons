# Credenciales de la cuenta preprod (account_id 10) usadas por githooks/pre-push
# para correr los tests de integracion de accesos antes de un push a master.
#
# Copia este archivo a `secrets/preprod_test.env` (ese si esta gitignored) y
# llena los valores reales. Deben ser los mismos que usa el workflow de CI
# (.github/workflows/test-pases-entrada.yml) via GitHub secrets
# PREPROD_USERNAME / PREPROD_APIKEY / PREPROD_ACCOUNT_ID.

PREPROD_USERNAME=
PREPROD_APIKEY=
PREPROD_ACCOUNT_ID=10
