# Plantilla del catalogo de cuentas.
#
# Copiala a secrets/accounts.ini y llena tus credenciales. Ese archivo NO se versiona:
# secrets/ va por lista blanca en .gitignore y el hook pre-commit lo bloquea.
#
# La cuenta activa se elige con:   ./lkf workwith <domain_name>
# y queda guardada en:             secrets/current_domain
#
# Toda llave de una seccion se sube a `config` en MAYUSCULAS (username -> USERNAME), asi
# que para agregar una nueva basta ponerla aqui. Las unicas que no viajan a `config` son
# branch_name y account_id, que solo usa workwith.

[global]
# Secretos compartidos por todas las cuentas.
couch_user           =
couch_password       =
couch_dev_user       =
couch_dev_password   =
openai_api_key       =

# El nombre de la seccion es el domain_name: lo que tecleas en `workwith <domain_name>`,
# y tambien el nombre de la rama en el submodulo modules/.
[mi_dominio]
username             = usuario@ejemplo.com
apikey               =
# Opcionales:
# couch_user         =
# couch_password     =
# openrouter_api_key =
#
# branch_name: SOLO si la rama de modules no se llama como la seccion, o sea si la cuenta
# todavia no tiene su rama con nombre de dominio. Dasela con `./lkf branches create` (copia
# la rama vieja `account_<id>` a una nueva llamada como la seccion, sin borrar la vieja) y
# despues borra esta llave -- `create` la borra por ti.
# branch_name        = account_1234
#
# account_id: informativo para humanos, y lo que usan `./lkf branches` y el aviso de
# `workwith` para encontrar la rama vieja `account_<id>` del par. El real lo deriva el login.
# account_id         = 1234
