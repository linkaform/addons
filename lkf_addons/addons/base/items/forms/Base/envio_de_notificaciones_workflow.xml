            color: #444444;
            line-height: 1.6;
        }

        .content p {
            margin: 0 0 15px;
            font-size: 16px;
            
        }

        .highlighted-message {
            background-color: #f9f9f9;
            border-left: 4px solid #021d49;
            padding: 20px;
            margin: 25px 0;
            border-radius: 0 6px 6px 0;
        }

        .label {
            color: #888888;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: bold;
            display: block;
            margin-bottom: 5px;
        }

        .value {
            color: #021d49;
            font-size: 18px;
            font-weight: 600;
        }

        .footer {
            background-color: #fafafa;
            text-align: center;
            color: #999999;
            padding: 10px;
            font-size: 12px;
            border-top: 1px solid #eeeeee;
        }

        .footer a {
            color: #021d49;
            text-decoration: none;
        }

        .footer img {
            filter: none;
            opacity: 1;
        }
    &lt;/style&gt;
&lt;/head&gt;

&lt;body&gt;
    &lt;div class="email-container"&gt;
        &lt;div class="header"&gt;
            &lt;img alt="logo" src="https://f001.backblazeb2.com/file/app-linkaform/public-client-126/71202/60b81349bde5588acca320e1/69457fa7593f4a5b767be3c1.png"&gt;
        &lt;/div&gt;

        &lt;div class="content" style="padding-bottom: 20px !important;"&gt;
