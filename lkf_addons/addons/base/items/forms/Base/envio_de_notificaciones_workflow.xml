    &lt;style&gt;
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        }

        .email-container {
            max-width: 600px;
            margin: 20px auto;
            background-color: #ffffff;
            border: 1px solid #eeeeee;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        .header {
            background-color: #021d49;
            padding: 25px;
            text-align: center;
        }

        .header img {
            max-width: 130px;
            height: auto;
        }

        .content {
