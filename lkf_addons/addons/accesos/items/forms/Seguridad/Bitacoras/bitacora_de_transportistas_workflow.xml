      &lt;span style="background-color:#e6f0fa; color:#021d49; font-size:13px; font-weight:bold; padding:6px 16px; border-radius:16px; text-transform:uppercase; letter-spacing:0.5px; display:inline-block; margin-bottom:12px;"&gt;
        ESTATUS: {{record.answers.6a31921f07fb9cb5840d1f22}}
