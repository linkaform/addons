  &lt;meta charset="UTF-8"&gt;
  &lt;title&gt;Pase de Entrada - Transportista&lt;/title&gt;
&lt;/head&gt;
&lt;body style="margin:0; padding:0; font-family: Arial, sans-serif; background-color:#f7f9fb; color:#333;"&gt;

  &lt;!-- Contenedor principal --&gt;
  &lt;div style="max-width:600px; margin:0 auto; background:#ffffff; border-radius:12px; overflow:hidden; box-shadow:0 2px 6px rgba(0,0,0,0.08);"&gt;

    &lt;!-- Header con logo --&gt;
    &lt;div style="text-align:center; padding:25px 20px; background:#f1f4f8;"&gt;
        &lt;img src="https://f001.backblazeb2.com/file/lkf-media/company_pictures/company_pic_10.thumbnail" alt="Logo" style="max-height:120px;"&gt;
    &lt;/div&gt;

    &lt;!-- Encabezado del Pase y Estatus --&gt;
    &lt;div style="padding:25px 25px 10px 25px; text-align:center; background:#ffffff;"&gt;
