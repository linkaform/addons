        Se ha registrado una operación de transporte con la siguiente información:
      &lt;/p&gt;
    &lt;/div&gt;

    &lt;!-- Datos del Transportista e Información General --&gt;
    &lt;div style="padding:20px 25px; background:#ffffff;"&gt;
      &lt;h3 style="margin-top:0; font-size:16px; color:#021d49; margin-bottom:12px;"&gt;
        Información del Transporte
      &lt;/h3&gt;
      
      &lt;table style="width:100%; border-collapse:collapse; font-size:14px; color:#444;"&gt;
        &lt;tr&gt;
          &lt;td style="padding:6px 0; font-weight:bold; width:45%; color:#021d49;"&gt;Folio:&lt;/td&gt;
          &lt;td style="padding:6px 0;"&gt;{{record.folio}}&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr&gt;
          &lt;td style="padding:6px 0; font-weight:bold; color:#021d49;"&gt;Tipo de operación:&lt;/td&gt;
          &lt;td style="padding:6px 0;"&gt;{{record.answers.6a31929d0bf8c5fc715d7425}}&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr&gt;
          &lt;td style="padding:6px 0; font-weight:bold; color:#021d49;"&gt;Empresa / Transportista:&lt;/td&gt;
          &lt;td style="padding:6px 0;"&gt;{{record.answers.6a31929d0bf8c5fc715d7424}}&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr&gt;
          &lt;td style="padding:6px 0; font-weight:bold; color:#021d49;"&gt;Proveedor / Cliente:&lt;/td&gt;
          &lt;td style="padding:6px 0;"&gt;{{record.answers.6a42dfd48e70db919887e4b0}}&lt;/td&gt;
        &lt;/tr&gt;
      &lt;/table&gt;
    &lt;/div&gt;

    &lt;!-- Línea divisoria sutil --&gt;
    &lt;div style="padding:0 25px; background:#ffffff;"&gt;
      &lt;hr style="border:0; border-top:1px solid #e6e9ef; margin:0;"&gt;
    &lt;/div&gt;

    &lt;!-- Tiempos de Operación --&gt;
    &lt;div style="padding:20px 25px 25px 25px; background:#ffffff;"&gt;
      &lt;h3 style="margin-top:0; font-size:16px; color:#021d49; margin-bottom:12px;"&gt;
        Tiempos de Operación
      &lt;/h3&gt;
      
      &lt;table style="width:100%; border-collapse:collapse; font-size:14px; color:#444;"&gt;
        &lt;tr&gt;
          &lt;td style="padding:6px 0; font-weight:bold; color:#021d49; width:45%;"&gt;Fecha y hora de ingreso:&lt;/td&gt;
          &lt;td style="padding:6px 0; color:#333;"&gt;{{record.answers.6a3bee0a7829a4ca9572d39e}}&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr&gt;
          &lt;td style="padding:6px 0; font-weight:bold; color:#021d49;"&gt;Fecha y hora de descarga:&lt;/td&gt;
          &lt;td style="padding:6px 0; color:#333;"&gt;{{record.answers.6a3bee0a7829a4ca9572d39f}}&lt;/td&gt;
