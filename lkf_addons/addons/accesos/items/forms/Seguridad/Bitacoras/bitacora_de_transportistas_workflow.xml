      &lt;div style="margin-top:10px;"&gt;
        &lt;a href="https://www.linkaform.com/" target="_blank"&gt;
          &lt;img src="https://f001.backblazeb2.com/file/app-linkaform/public-client-126/107023/64dd1bd4fd200a3308ec2141/663517c3caae08b8adf27472.png" width="120px" alt="Linkaform"&gt;
        &lt;/a&gt;
      &lt;/div&gt;
    &lt;/div&gt;

