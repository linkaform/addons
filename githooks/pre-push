#!/usr/bin/env bash
# Antes de dejar salir un push a master, corre el test de pases de entrada
# contra preprod. Si falla, el push se cancela.
#
# Instalar una vez por clon: git config core.hooksPath githooks
# Saltarse una vez si hace falta: git push --no-verify

BLOCK_BRANCH="refs/heads/master"
should_run=false

while read local_ref local_sha remote_ref remote_sha; do
    if [ "$remote_ref" = "$BLOCK_BRANCH" ]; then
        should_run=true
    fi
done

if [ "$should_run" = false ]; then
    exit 0
fi

echo "-> Push a master detectado: corriendo test de pases de entrada contra preprod..."
echo "   (para saltarte esto una vez: git push --no-verify)"

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

# Credenciales dedicadas de preprod (cuenta 10), separadas de tu
# config/local_settings.py de trabajo diario. Asi el test no depende de qué
# cuenta tengas activa localmente -- igual que CI, que las inyecta desde
# GitHub secrets en vez de usar el local_settings.py del working directory.
PREPROD_ENV_FILE="$REPO_ROOT/secrets/preprod_test.env"
if [ ! -f "$PREPROD_ENV_FILE" ]; then
    echo "x Falta $PREPROD_ENV_FILE con las credenciales de preprod (cuenta 10)."
    echo "  Copia secrets/preprod_test.env.example y llena los valores. Push cancelado."
    exit 1
fi
# shellcheck disable=SC1090
source "$PREPROD_ENV_FILE"
if [ -z "$PREPROD_USERNAME" ] || [ -z "$PREPROD_APIKEY" ] || [ -z "$PREPROD_ACCOUNT_ID" ]; then
    echo "x $PREPROD_ENV_FILE existe pero le faltan valores (PREPROD_USERNAME/PREPROD_APIKEY/PREPROD_ACCOUNT_ID). Push cancelado."
    exit 1
fi

# Copia de config/ con ENV forzado a preprod y local_settings.py regenerado
# desde las credenciales de preprod de arriba, para no depender de (ni tocar)
# tu config real. Este test solo debe poder correr contra preprod cuenta 10.
CONFIG_COPY="$(mktemp -d)"
trap 'rm -rf "$CONFIG_COPY"' EXIT
cp -R "$REPO_ROOT/config/." "$CONFIG_COPY/"
sed -i.bak "s/^ENV = 'prod'/# ENV = 'prod'/; s/^# ENV = 'preprod'/ENV = 'preprod'/" "$CONFIG_COPY/enviorment.py"
rm -f "$CONFIG_COPY/enviorment.py.bak"

cat > "$CONFIG_COPY/local_settings.py" <<EOF
# coding: utf-8
from settings import *
from uts import update_settings

config.update({
    'USERNAME': '$PREPROD_USERNAME',
    'APIKEY': '$PREPROD_APIKEY',
    'ACCOUNT_ID': '$PREPROD_ACCOUNT_ID',
})

settings.config.update(config)
settings = update_settings(settings)
EOF

docker build --platform linux/amd64 -f test/docker/Dockerfile --target develop -t linkaform/lkf_test:develop test/docker
if [ $? -ne 0 ]; then
    echo "x No se pudo construir la imagen de test. Push cancelado."
    exit 1
fi

docker run --rm \
    -v "$REPO_ROOT/secrets/lkf_jwt_key.pub:/etc/ssl/certs/lkf_jwt_key.pub" \
    -v "$REPO_ROOT/lkf_addons:/usr/local/lib/python3.10/site-packages/lkf_addons" \
    -v "$REPO_ROOT/modules:/usr/local/lib/python3.10/site-packages/lkf_modules" \
    -v "$REPO_ROOT/test:/srv/lkf_test" \
    -v "$CONFIG_COPY:/srv/scripts/addons/config" \
    -w /srv/lkf_test \
    linkaform/lkf_test:develop \
    pytest sdk_testing/accesos/passes/integration/test_create_access_pass_api.py -v

test_exit=$?
if [ $test_exit -ne 0 ]; then
    echo ""
    echo "x Los tests de pases de entrada fallaron contra preprod. Push cancelado."
    echo "  Corrige el problema, o usa 'git push --no-verify' si necesitas saltarte esto (no recomendado)."
    exit 1
fi

echo "OK: tests de pases de entrada pasaron. Continuando con el push."
exit 0
